<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Sistema de Gestion de Trabajos de Grado - UTS</display-name>

    <!--
        Tomcat decodifica los parametros de un POST (application/x-www-form-urlencoded)
        con ISO-8859-1 por defecto, sin importar que la pagina declare UTF-8 - eso
        solo controla la salida, no la entrada. Sin esto, los acentos y enies
        escritos en los formularios (login, alta de usuario, etc.) llegan mal
        decodificados a ${param....}. SetCharacterEncodingFilter es una clase que
        trae el propio Tomcat (org.apache.catalina.filters, dentro de catalina.jar);
        esto es solo configuracion XML, no se escribio ningun .java para esto.
    -->
    <filter>
        <filter-name>FijarCodificacionUTF8</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>false</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>FijarCodificacionUTF8</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
        multipart-config declarado solo en la pagina que recibe archivos
        (RF-15), segun la decision de carga de archivos sin .java (ver
        SEGUIMIENTO_PROYECTO.md). 10 MB de limite total porque pueden ser
        hasta 3 PDFs (liquidacion + 2 soportes de pago).
    -->
    <servlet>
        <servlet-name>procesarPago</servlet-name>
        <jsp-file>/procesar-pago.jsp</jsp-file>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>15728640</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>procesarPago</servlet-name>
        <url-pattern>/procesar-pago.jsp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>procesarPagoCompletar</servlet-name>
        <jsp-file>/procesar-pago-completar.jsp</jsp-file>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>5242880</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>procesarPagoCompletar</servlet-name>
        <url-pattern>/procesar-pago-completar.jsp</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
