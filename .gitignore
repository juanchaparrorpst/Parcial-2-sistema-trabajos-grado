# Compilados Java
*.class

# WAR generado (se construye a partir del codigo, no se versiona)
*.war

# Directorios de build (Maven/Gradle u otros, por si se agregan mas adelante)
/target/
/build/

# Logs de Tomcat (los reales viven en C:\xampp\tomcat\logs, fuera del proyecto;
# esto cubre logs que llegue a generar la propia app dentro de sistema-tg)
/logs/
*.log

# Configuracion con credenciales de produccion (no se sube al repo;
# en produccion esos datos se leen de variables de entorno, ver SEGUIMIENTO_PROYECTO.md)
**/context.xml
context-produccion.xml

# Archivos subidos por los usuarios (soporte de pago, formatos F-DC-124/125,
# informe de Turnitin, documentos fase 4 - ver SEGUIMIENTO_PROYECTO.md, decision
# de carga de archivos). Es contenido generado en tiempo de ejecucion, no codigo;
# la carpeta se versiona vacia (.gitkeep) pero su contenido no.
/uploads/*
!/uploads/.gitkeep

# Copias de seguridad de la base de datos (RNF-10). Contienen todos los datos
# de la aplicacion (incluidos los hashes de contrasena); nunca se suben al
# repositorio. Viven fuera de /uploads porque esa carpeta SI es publica
# (Tomcat la sirve como estatica) y estas no deben serlo.
/WEB-INF/backups/*
!/WEB-INF/backups/.gitkeep

# Temporales del sistema operativo
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.swp
